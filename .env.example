# =============================================================================
# Recipe Extractor - Environment Variables
# =============================================================================
# Copy this file to `.env` (local development) or set these in your Netlify
# dashboard (Production / Deploy settings → Environment variables).
# =============================================================================

# ---- Database (Neon PostgreSQL) ----
# Get this from your Neon dashboard: https://console.neon.tech
# Format: postgresql://USER:PASSWORD@ep-HOST.region.aws.neon.tech/DBNAME?sslmode=require
# IMPORTANT: Use the pooled connection string for serverless (Neon's free tier
# includes a pooler). The "direct connection" extension is a paid feature.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/recipe_extractor?sslmode=require"

# ---- Netlify Identity ----
# This is auto-provisioned when you enable Netlify Identity on your site.
# You don't need to set it manually - the widget handles auth in the browser.
# NETLIFY_IDENTITY_URL is set automatically by Netlify.
NETLIFY_IDENTITY_URL=""

# ---- Apify (Instagram Scraper) ----
# Get a free API token at https://console.apify.com/account/settings/api
# The free tier gives you $5/month of credits (~25 Instagram scrapes).
APIFY_API_TOKEN="apify_api_xxxxxxxxxxxxxxxxxxx"

# The Apify actor ID for Instagram Reels scraping.
# Default: "apify/instagram-reel-scraper" — purpose-built for reels, returns
# videoUrl, caption, and latestComments. ~$0.009/reel on the free tier.
#
# Alternatives (same input format: { username: [url] }):
#   - apify/instagram-post-scraper  (cheaper, ~$0.003/post, same output)
APIFY_INSTAGRAM_ACTOR="apify/instagram-reel-scraper"

# Optional: Override the comment scraper actor.
# Default: tries "apify/instagram-api-scraper" (up to 50 comments) then falls
# back to "apify/instagram-comment-scraper".
#
# NOTE: Apify's FREE plan caps comments at 15 per URL on most actors.
# To fetch ALL comments, use:
#   APIFY_COMMENT_ACTOR="apidojo/instagram-comments-scraper-api"
# This is pay-per-use (~$0.03/post) but fetches all comments, not just 15.
APIFY_COMMENT_ACTOR=""

# ---- Google Gemini (Recipe LLM) ----
# Get a free API key at https://aistudio.google.com/app/apikey
# The free tier supports gemini-2.5-flash-lite (and the model name you requested:
# "gemini-3.1-flash-lite" — if Google ships that name, set GEMINI_MODEL to it).
GEMINI_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GEMINI_MODEL="gemini-2.5-flash-lite"

# ---- Whisper (Speech-to-Text) via Groq API ----
# Groq offers a free, reliable Whisper API (14,400 requests/day).
# We use Groq instead of HuggingFace because HuggingFace's API has DNS
# resolution issues (ENOTFOUND) from Netlify Lambda functions.
#
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WHISPER_MODEL="whisper-large-v3"

# ---- OCR (Tesseract.js) — runs client-side in the browser ----
# Language defaults to English. For other languages, set this.
# Note: uses NEXT_PUBLIC_ prefix so it's available client-side.
NEXT_PUBLIC_TESSERACT_LANG="eng"

# ---- Video Processing ----
# Frame extraction interval in seconds (1 or 2 recommended).
FRAME_INTERVAL_SECONDS="2"
# Maximum number of frames to OCR (to bound processing time).
MAX_FRAMES_TO_OCR="30"

# ---- App Config ----
# The base URL of your deployed site (used for Netlify Identity redirects).
NEXT_PUBLIC_SITE_URL="https://your-site-name.netlify.app"
