// This is the Prisma schema file for the Recipe Extractor app.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Using PostgreSQL for Neon database.
  // Set DATABASE_URL in your .env file (and Netlify env vars) to your Neon connection string.
  // Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  settings  Json?    // User preferences (theme, units, etc.) — synced across devices
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes        Recipe[]
  pantryItems    PantryItem[]
  shoppingLists  ShoppingList[]
  recurringItems RecurringItem[]
}

model Recipe {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?

  // JSON-encoded array of { name, amount, unit, notes?, evidence?, flag? }
  ingredients Json

  // JSON-encoded array of { step, evidence?, flag?, ingredientRefs? }
  // ingredientRefs: array of ingredient indices this step uses
  instructions Json

  // JSON-encoded array of { key, value, evidence?, flag? }
  metadata    Json

  // JSON-encoded array of warning/flag objects
  flags       Json

  // Raw source data
  sourceUrl      String?
  sourceCaption  String?
  sourceComments Json?
  transcript     String?
  ocrText        String?

  imageUrl    String?
  sourceVideoUrl String?

  // User features
  isFavorite  Boolean  @default(false)
  tags        Json?    // JSON array of strings: ["quick", "vegetarian", ...]
  collection  String?  // Custom collection name: "Friday cooking", "Fakeaways", etc.

  // Canonicalization version — tracks which prompt version was used for the
  // ingredients' canonical data. Matches CURRENT_CANONICAL_VERSION in canonicalize.ts.
  // Used by the backfill script to know which recipes need re-canonicalization.
  canonicalVersion Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isFavorite])
  @@index([collection])
}

// ---- Pantry ----

model PantryItem {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  genericName   String?  // Canonical name from Gemini (e.g. "bell pepper", "chicken breast")
  canonicalAncestors  Json?  // Array of ancestor TYPES (IS-A), e.g. ["wheat noodles", "noodles"]
  canonicalAttributes Json?  // Object of attributes, e.g. {"color": "red", "state": "dry"}
  canonicalHardAttributeKeys Json?  // Array of attribute keys that are "hard" (blocking for matching)
  canonicalVersion    Int?    // Which prompt version was used (matches CURRENT_CANONICAL_VERSION in canonicalize.ts)
  category      String?  // e.g. "Produce", "Dairy", "Meat & Fish"
  quantity      String?  // e.g. "2", "500g", "1 box"
  expiryDate    DateTime?
  barcode       String?
  isRunningLow  Boolean  @default(false)
  fillPercent   Int      @default(100)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([genericName])
}

// ---- Shopping Lists ----

model ShoppingList {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String   @default("Shopping List")
  storeName   String?  // e.g. "Tesco", "Waitrose"

  items       ShoppingItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model ShoppingItem {
  id            String   @id @default(cuid())
  shoppingList  ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  shoppingListId String

  name          String
  genericName   String?  // For matching with pantry
  quantity      String?
  section       String?  // e.g. "Produce", "Dairy", "Bakery", "Frozen"
  sectionOrder  Int      @default(0) // Custom ordering of sections
  isChecked     Boolean  @default(false)
  recipeId      String?  // If this item was added from a recipe

  createdAt     DateTime @default(now())

  @@index([shoppingListId])
  @@index([section])
}

// ---- Recurring Items ----
// Items the user buys every shop. Auto-added to new shopping lists.
model RecurringItem {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  genericName   String?
  quantity      String?
  section       String?
  sectionOrder  Int      @default(0)

  createdAt     DateTime @default(now())

  @@index([userId])
}

model ExtractionJob {
  id        String   @id @default(cuid())
  userId    String
  status    String   @default("pending") // pending, processing, completed, failed
  progress  Int      @default(0) // 0-100
  step      String?  // current step description
  error     String?
  recipeId  String?  // created recipe ID on success
  sourceUrl String?
  logs      String?  // JSON-encoded array of { step, status, message, timestamp }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
